{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/demo",
      "destination": "https://demo.marcacoes.app",
      "permanent": false
    },
    {
      "source": "/demonstracao",
      "destination": "https://demo.marcacoes.app",
      "permanent": false
    },
    {
      "source": "/painel",
      "destination": "https://administrador.marcacoes.app/entrar?demo=1",
      "permanent": false
    },
    {
      "source": "/servicos",
      "destination": "/funcionalidades",
      "permanent": true
    },
    {
      "source": "/processo",
      "destination": "/como-funciona",
      "permanent": true
    },
    {
      "source": "/booking",
      "destination": "/funcionalidades",
      "permanent": true
    },
    {
      "source": "/booking/:caminho*",
      "destination": "/funcionalidades",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/funcionalidades",
      "destination": "/funcionalidades.html"
    },
    {
      "source": "/como-funciona",
      "destination": "/como-funciona.html"
    },
    {
      "source": "/precos",
      "destination": "/precos.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/instagram",
      "destination": "/instagram.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/termos",
      "destination": "/termos.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|ico|webp|mp4|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
