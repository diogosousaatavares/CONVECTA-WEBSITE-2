{
  "trailingSlash": false,
  "redirects": [
    { "source": "/demo", "destination": "https://demo.marcacoes.app", "permanent": false },
    { "source": "/demonstracao", "destination": "https://demo.marcacoes.app", "permanent": false },
    { "source": "/painel", "destination": "https://administrador.marcacoes.app/entrar?demo=1", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/funcionalidades", "destination": "/funcionalidades.html" },
    { "source": "/como-funciona", "destination": "/como-funciona.html" },
    { "source": "/precos", "destination": "/precos.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/contacto", "destination": "/contacto.html" },
    { "source": "/instagram", "destination": "/instagram.html" },
    { "source": "/privacidade", "destination": "/privacidade.html" },
    { "source": "/termos", "destination": "/termos.html" },
    { "source": "/(.*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
