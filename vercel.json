{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/demo",
      "destination": "/comecar",
      "permanent": false
    },
    {
      "source": "/demonstracao",
      "destination": "/comecar",
      "permanent": false
    },
    {
      "source": "/painel",
      "destination": "https://administrador.marcacoes.app/entrar",
      "permanent": false
    },
    {
      "source": "/servicos",
      "destination": "/funcionalidades",
      "permanent": true
    },
    {
      "source": "/processo",
      "destination": "/como-funciona",
      "permanent": true
    },
    {
      "source": "/booking",
      "destination": "/funcionalidades",
      "permanent": true
    },
    {
      "source": "/booking/:caminho*",
      "destination": "/funcionalidades",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/funcionalidades",
      "destination": "/funcionalidades.html"
    },
    {
      "source": "/como-funciona",
      "destination": "/como-funciona.html"
    },
    {
      "source": "/precos",
      "destination": "/precos.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/instagram",
      "destination": "/instagram.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/termos",
      "destination": "/termos.html"
    },
    {
      "source": "/comecar",
      "destination": "/comecar.html"
    },
    {
      "source": "/software-para-barbearias",
      "destination": "/software-para-barbearias.html"
    },
    {
      "source": "/sobre",
      "destination": "/sobre.html"
    },
    {
      "source": "/agenda-online-barbearia",
      "destination": "/agenda-online-barbearia.html"
    },
    {
      "source": "/marcacoes-online-barbearia",
      "destination": "/marcacoes-online-barbearia.html"
    },
    {
      "source": "/gestao-barbearia",
      "destination": "/gestao-barbearia.html"
    },
    {
      "source": "/gestao-clientes-barbearia",
      "destination": "/gestao-clientes-barbearia.html"
    },
    {
      "source": "/comissoes-barbeiros",
      "destination": "/comissoes-barbeiros.html"
    },
    {
      "source": "/app-para-barbearia",
      "destination": "/app-para-barbearia.html"
    },
    {
      "source": "/comparar/fresha",
      "destination": "/comparar/fresha.html"
    },
    {
      "source": "/comparar/treatwell",
      "destination": "/comparar/treatwell.html"
    },
    {
      "source": "/comparar/booksy",
      "destination": "/comparar/booksy.html"
    },
    {
      "source": "/comparar/buk",
      "destination": "/comparar/buk.html"
    },
    {
      "source": "/comparar/zappy",
      "destination": "/comparar/zappy.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/melhores-softwares-marcacoes-barbearias-portugal",
      "destination": "/blog/melhores-softwares-marcacoes-barbearias-portugal.html"
    },
    {
      "source": "/blog/marketplace-ou-agenda-propria",
      "destination": "/blog/marketplace-ou-agenda-propria.html"
    },
    {
      "source": "/blog/quanto-custa-software-marcacoes-barbearia",
      "destination": "/blog/quanto-custa-software-marcacoes-barbearia.html"
    },
    {
      "source": "/blog/como-reduzir-faltas-marcacoes-barbearia",
      "destination": "/blog/como-reduzir-faltas-marcacoes-barbearia.html"
    },
    {
      "source": "/blog/como-calcular-comissoes-barbeiros",
      "destination": "/blog/como-calcular-comissoes-barbeiros.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|ico|webp|mp4|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
